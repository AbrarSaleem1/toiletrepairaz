---
interface Props {
  businessName?: string;
  phone?: string;
  address?: string;
  email?: string;
}

const {
  businessName = 'Arizona Toilet Repair Co.',
  phone = '(833) 845-0906',
  address = '9009 N 7th St #201, Phoenix, AZ 85020, USA',
  email = 'dispatch@toiletrepairaz.us',
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer">
  <!-- Main Footer -->
  <div class="footer-main">
    <div class="container">
      <div class="footer-grid">
        <!-- Company Info -->
        <div class="footer-col footer-about">
          <a href="/" class="footer-logo">
            <div class="logo-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <span class="footer-logo-name">{businessName}</span>
          </a>
          <p class="footer-desc">
            With 15+ years of dedicated plumbing expertise, Arizona Toilet Repair Co. provides 24/7 licensed and insured toilet repair, clog clearing, and leak restoration across the entire Grand Canyon State.
          </p>
          <div class="footer-contact-list">
            <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="footer-contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              {phone}
            </a>
            <span class="footer-contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              24/7 Emergency Dispatch
            </span>
            <span class="footer-contact-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              {address}
            </span>
          </div>
        </div>

        <!-- Quick Links -->
        <div class="footer-col">
          <h4 class="footer-heading">Quick Links</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/services/">All Services</a></li>
            <li><a href="/locations/">Arizona Service Areas (187 Cities)</a></li>
            <li><a href="/about-us/">About Our Company</a></li>
            <li><a href="/contact-us/">Contact & Dispatch</a></li>
          </ul>
        </div>

        <!-- Services -->
        <div class="footer-col">
          <h4 class="footer-heading">Toilet Services</h4>
          <ul class="footer-links">
            <li><a href="/services/clogged-toilet-unclogging/">Clogged Toilet Unclogging</a></li>
            <li><a href="/services/toilet-leak-repair/">Toilet Leak Repair</a></li>
            <li><a href="/services/running-toilet-repair/">Running Toilet Repair</a></li>
            <li><a href="/services/flapper-fill-valve-replacement/">Flapper & Fill Valve Replacement</a></li>
            <li><a href="/services/emergency-toilet-repair/">Emergency Toilet Repair</a></li>
            <li><a href="/services/flange-repair/">Toilet Flange Repair</a></li>
            <li><a href="/services/commercial-toilet-repair/">Commercial Toilet Repair</a></li>
          </ul>
        </div>

        <!-- Service Areas -->
        <div class="footer-col">
          <h4 class="footer-heading">Key Arizona Cities</h4>
          <ul class="footer-links">
            <li><a href="/locations/phoenix/">Phoenix</a></li>
            <li><a href="/locations/mesa/">Mesa</a></li>
            <li><a href="/locations/scottsdale/">Scottsdale</a></li>
            <li><a href="/locations/chandler/">Chandler</a></li>
            <li><a href="/locations/gilbert/">Gilbert</a></li>
            <li><a href="/locations/glendale/">Glendale</a></li>
            <li><a href="/locations/tucson/">Tucson</a></li>
            <li><a href="/locations/">View All 187 Cities &rarr;</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-inner">
        <p class="footer-copyright">
          &copy; {currentYear} {businessName}. All rights reserved.
        </p>
        <div class="footer-bottom-links">
          <a href="/privacy-policy/">Privacy Policy</a>
          <span class="footer-sep">|</span>
          <a href="/terms/">Terms of Service</a>
          <span class="footer-sep">|</span>
          <a href="/sitemap.xml">Sitemap</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.8);
  }

  .footer-main {
    padding: var(--space-16) 0 var(--space-12);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-10);
  }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Footer Logo */
  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .footer-logo:hover {
    color: var(--color-white);
  }

  .footer-logo .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: var(--radius-sm);
  }

  .footer-logo-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 800;
  }

  .footer-desc {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-5);
  }

  .footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-contact-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--duration-fast) var(--ease-default);
  }

  a.footer-contact-item:hover {
    color: var(--color-accent-light);
  }

  .footer-contact-item svg {
    flex-shrink: 0;
    color: var(--color-primary-light);
  }

  /* Footer Headings */
  .footer-heading {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: var(--space-5);
    position: relative;
    padding-bottom: var(--space-3);
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 3px;
    background: var(--color-primary);
    border-radius: var(--radius-full);
  }

  /* Footer Links */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-links a {
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--text-sm);
    transition: all var(--duration-fast) var(--ease-default);
    padding: var(--space-1) 0;
  }

  .footer-links a:hover {
    color: var(--color-accent-light);
    padding-left: var(--space-2);
  }

  /* Footer Bottom */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: var(--space-5) 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-copyright {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .footer-bottom-links a {
    color: rgba(255, 255, 255, 0.4);
  }

  .footer-bottom-links a:hover {
    color: var(--color-accent-light);
  }

  .footer-sep {
    color: rgba(255, 255, 255, 0.15);
  }
</style>
