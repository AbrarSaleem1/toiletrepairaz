---
interface Props {
  cityName?: string;
  countyName?: string;
}

const { cityName = 'Arizona', countyName = '' } = Astro.props;

const mainServices = [
  {
    icon: '🚽',
    title: 'Clogged Toilet Unclogging',
    desc: 'Heavy-duty closet augering and drain clearing for stubborn obstructions without porcelain damage.',
    href: '/services/clogged-toilet-unclogging/',
  },
  {
    icon: '💧',
    title: 'Toilet Leak Repair',
    desc: 'Stop base leaks, hairline tank cracks, rotted seals, and dripping shutoff valves before subfloor damage occurs.',
    href: '/services/toilet-leak-repair/',
  },
  {
    icon: '🔄',
    title: 'Running Toilet Repair',
    desc: 'End phantom flushing and continuous water cycling that causes costly spikes on your monthly water bill.',
    href: '/services/running-toilet-repair/',
  },
  {
    icon: '⚙️',
    title: 'Flapper & Fill Valve Replacement',
    desc: 'Heavy-duty silicone flappers and anti-siphon valves engineered specifically for mineral-heavy Arizona water.',
    href: '/services/flapper-fill-valve-replacement/',
  },
  {
    icon: '🚨',
    title: 'Emergency Toilet Repair',
    desc: '24/7 immediate priority dispatch across Arizona for overflows, sewage backups, and sole-bathroom outages.',
    href: '/services/emergency-toilet-repair/',
  },
  {
    icon: '🔧',
    title: 'Toilet Flange Repair',
    desc: 'Reconstruct broken PVC collars, rusted cast-iron rings, and anchor wobbling bowls rock-solid to the floor.',
    href: '/services/flange-repair/',
  },
  {
    icon: '🏢',
    title: 'Commercial Toilet Repair',
    desc: 'Sloan and Zurn flushometer rebuilding, ADA compliance fixtures, and high-traffic commercial facility repairs.',
    href: '/services/commercial-toilet-repair/',
  },
];
---

<section class="section" id="services" style="padding: var(--space-16) 0; background: var(--color-bg-alt, #f8fafc); border-top: 1px solid var(--color-border-light); border-bottom: 1px solid var(--color-border-light);">
  <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 0 1.25rem;">
    <div class="text-center" style="max-width: 760px; margin: 0 auto var(--space-12);">
      <span class="badge" style="background: rgba(234, 88, 12, 0.12); color: #ea580c; border: 1px solid rgba(234, 88, 12, 0.25); padding: 5px 14px; border-radius: 999px; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; margin-bottom: var(--space-3); display: inline-block;">
        Our Solutions
      </span>
      <h2 style="color: var(--color-primary); font-size: clamp(1.85rem, 3.2vw, 2.5rem); margin-bottom: var(--space-4); font-weight: 800;">
        {cityName === 'Arizona' ? 'Complete Toilet Repair Services in Arizona' : `Complete Toilet Repair Services in ${cityName}, AZ`}
      </h2>
      <p style="color: var(--color-text-secondary); font-size: 1.05rem; line-height: 1.6;">
        From stubborn clogs and running tanks to broken flanges and commercial flushometers, we provide complete toilet solutions built to handle Arizona water conditions.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-6);">
      {mainServices.map((service) => (
        <div class="card service-card" style="padding: var(--space-8); display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--color-border-light); border-radius: 16px; background: #ffffff; box-shadow: 0 4px 20px rgba(0,0,0,0.04); transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;">
          <div>
            <div style="width: 50px; height: 50px; background: #e0f2fe; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.65rem; margin-bottom: var(--space-4);">
              {service.icon}
            </div>
            <h3 style="color: var(--color-primary); font-size: 1.25rem; font-weight: 800; margin-bottom: var(--space-2);">
              <a href={service.href} style="color: inherit; text-decoration: none;">{service.title}</a>
            </h3>
            <p style="color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: var(--space-6);">{service.desc}</p>
          </div>
          <a href={service.href} style="color: var(--color-accent); font-weight: 700; font-size: 0.925rem; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            View {service.title} &rarr;
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
