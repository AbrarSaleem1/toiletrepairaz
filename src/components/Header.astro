---
interface NavLink {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
}

interface Props {
  businessName?: string;
  phone?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  businessName = 'Arizona Toilet Repair Co.',
  phone = '(833) 845-0906',
  ctaText = 'Call 24/7',
  ctaHref = 'tel:+18338450906',
} = Astro.props;

const navLinks: NavLink[] = [
  { label: 'Home', href: '/' },
  {
    label: 'Services',
    href: '/services/',
    children: [
      { label: 'Clogged Toilet Unclogging', href: '/services/clogged-toilet-unclogging/' },
      { label: 'Toilet Leak Repair', href: '/services/toilet-leak-repair/' },
      { label: 'Running Toilet Repair', href: '/services/running-toilet-repair/' },
      { label: 'Flapper & Fill Valve Replacement', href: '/services/flapper-fill-valve-replacement/' },
      { label: 'Emergency Toilet Repair', href: '/services/emergency-toilet-repair/' },
      { label: 'Toilet Flange Repair', href: '/services/flange-repair/' },
      { label: 'Commercial Toilet Repair', href: '/services/commercial-toilet-repair/' },
      { label: 'View All Services', href: '/services/' },
    ],
  },
  {
    label: 'Locations',
    href: '/locations/',
    children: [
      { label: 'Phoenix', href: '/locations/phoenix/' },
      { label: 'Mesa', href: '/locations/mesa/' },
      { label: 'Scottsdale', href: '/locations/scottsdale/' },
      { label: 'Chandler', href: '/locations/chandler/' },
      { label: 'Gilbert', href: '/locations/gilbert/' },
      { label: 'Glendale', href: '/locations/glendale/' },
      { label: 'Peoria', href: '/locations/peoria/' },
      { label: 'Tucson', href: '/locations/tucson/' },
      { label: 'View All 187 Arizona Cities', href: '/locations/' },
    ],
  },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Contact', href: '/contact-us/' },
];
---

<header class="site-header" id="site-header">
  <!-- Top bar -->
  <div class="header-topbar">
    <div class="container">
      <div class="topbar-inner">
        <div class="topbar-left">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="topbar-phone">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>{phone}</span>
          </a>
          <span class="topbar-divider">|</span>
          <span class="topbar-hours">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            24/7 Emergency Service Available
          </span>
        </div>
        <div class="topbar-right">
          <span class="topbar-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3.09 6.26L22 8.27l-5 4.87 1.18 6.88L12 16.77l-6.18 3.25L7 13.14 2 8.27l6.91-1.01L12 1z"/></svg>
            Licensed & Insured
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <nav class="header-nav" aria-label="Main navigation">
    <div class="container">
      <div class="nav-inner">
        <!-- Logo -->
        <a href="/" class="nav-logo" aria-label={`${businessName} - Home`}>
          <div class="logo-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          </div>
          <div class="logo-text">
            <span class="logo-name">{businessName}</span>
          </div>
        </a>

        <!-- Desktop Nav -->
        <ul class="nav-links" id="nav-links">
          {navLinks.map((link) => (
            <li class={`nav-item ${link.children ? 'has-dropdown' : ''}`}>
              <a href={link.href} class="nav-link">
                {link.label}
                {link.children && (
                  <svg class="dropdown-arrow" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 4 5 7 8 4"/></svg>
                )}
              </a>
              {link.children && (
                <ul class="dropdown-menu">
                  {link.children.map((child) => (
                    <li>
                      <a href={child.href} class="dropdown-link">{child.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>

        <!-- CTA + Phone -->
        <div class="nav-actions">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="nav-phone-btn" aria-label={`Call ${phone}`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <a href={ctaHref} class="btn btn--primary btn--sm nav-cta">{ctaText}</a>
        </div>

        <!-- Mobile Toggle -->
        <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-overlay" id="mobile-overlay"></div>
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-header">
      <span class="logo-name">{businessName}</span>
      <button class="mobile-close" id="mobile-close" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <ul class="mobile-nav-links">
      {navLinks.map((link) => (
        <li class={`mobile-nav-item ${link.children ? 'has-dropdown' : ''}`}>
          <div class="mobile-nav-link-wrapper">
            <a href={link.href} class="mobile-nav-link">{link.label}</a>
            {link.children && (
              <button class="mobile-dropdown-toggle" aria-label={`Expand ${link.label}`}>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 6 8 10 12 6"/></svg>
              </button>
            )}
          </div>
          {link.children && (
            <ul class="mobile-dropdown">
              {link.children.map((child) => (
                <li>
                  <a href={child.href} class="mobile-dropdown-link">{child.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
    <div class="mobile-menu-footer">
      <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--primary btn--lg" style="width: 100%;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Call {phone}
      </a>
      <a href={ctaHref} class="btn btn--accent btn--lg" style="width: 100%;">
        {ctaText}
      </a>
    </div>
  </div>
</header>

<style>
  /* Top Bar */
  .header-topbar {
    background: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-sm);
    padding: var(--space-2) 0;
  }

  .topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .topbar-phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent-light);
    font-weight: 600;
  }

  .topbar-phone:hover {
    color: var(--color-accent);
  }

  .topbar-hours {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .topbar-divider {
    color: rgba(255, 255, 255, 0.25);
  }

  .topbar-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-accent-light);
    font-weight: 500;
  }

  .topbar-right {
    display: none;
  }

  @media (min-width: 768px) {
    .topbar-right {
      display: flex;
    }
  }

  /* Main Nav */
  .header-nav {
    background: var(--color-white);
    border-bottom: 1px solid var(--color-border-light);
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    transition: box-shadow var(--duration-normal) var(--ease-default);
  }

  .header-nav.scrolled {
    box-shadow: var(--shadow-md);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo:hover {
    color: var(--color-text);
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--color-primary);
    color: var(--color-white);
    border-radius: var(--radius-md);
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.2;
  }

  /* Desktop Links */
  .nav-links {
    display: none;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .nav-link:hover {
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .dropdown-arrow {
    transition: transform var(--duration-fast) var(--ease-default);
  }

  .nav-item:hover .dropdown-arrow {
    transform: rotate(180deg);
  }

  /* Desktop Dropdown */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    background: var(--color-white);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all var(--duration-normal) var(--ease-default);
    z-index: var(--z-dropdown);
  }

  .nav-item:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-sm);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .dropdown-link:hover {
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  /* Nav Actions */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-phone-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-primary-50);
    color: var(--color-primary);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .nav-phone-btn:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .nav-cta {
    display: none;
  }

  @media (min-width: 768px) {
    .nav-cta {
      display: inline-flex;
    }
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  @media (min-width: 1024px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2.5px;
    background: var(--color-text);
    border-radius: 2px;
    transition: all var(--duration-normal) var(--ease-default);
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  /* Mobile Overlay */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: var(--z-overlay);
    opacity: 0;
    visibility: hidden;
    transition: all var(--duration-normal) var(--ease-default);
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: min(360px, 85vw);
    height: 100dvh;
    background: var(--color-white);
    z-index: var(--z-modal);
    transform: translateX(100%);
    transition: transform var(--duration-slow) var(--ease-default);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  .mobile-menu.active {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--color-border-light);
  }

  .mobile-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-text);
    border: none;
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-default);
  }

  .mobile-close:hover {
    background: var(--color-error);
    color: var(--color-white);
  }

  .mobile-nav-links {
    flex: 1;
    padding: var(--space-4) var(--space-6);
    overflow-y: auto;
  }

  .mobile-nav-item {
    border-bottom: 1px solid var(--color-border-light);
  }

  .mobile-nav-link-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-nav-link {
    display: block;
    flex: 1;
    padding: var(--space-4) 0;
    color: var(--color-text);
    font-weight: 600;
    font-size: var(--text-base);
  }

  .mobile-dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-light);
    transition: all var(--duration-fast) var(--ease-default);
  }

  .mobile-dropdown-toggle.open svg {
    transform: rotate(180deg);
  }

  .mobile-dropdown {
    display: none;
    padding: 0 0 var(--space-3) var(--space-4);
  }

  .mobile-dropdown.open {
    display: block;
  }

  .mobile-dropdown-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-sm);
  }

  .mobile-dropdown-link:hover {
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  .mobile-menu-footer {
    padding: var(--space-6);
    border-top: 1px solid var(--color-border-light);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Hide topbar on small screens */
  @media (max-width: 640px) {
    .topbar-hours,
    .topbar-divider {
      display: none;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const close = document.getElementById('mobile-close');

  function openMenu() {
    menu?.classList.add('active');
    overlay?.classList.add('active');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.classList.remove('active');
    overlay?.classList.remove('active');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // Mobile dropdown toggles
  document.querySelectorAll('.mobile-dropdown-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const dropdown = btn.closest('.mobile-nav-item')?.querySelector('.mobile-dropdown');
      btn.classList.toggle('open');
      dropdown?.classList.toggle('open');
    });
  });

  // Sticky header shadow
  const header = document.querySelector('.header-nav');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 10);
  }, { passive: true });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });
</script>
