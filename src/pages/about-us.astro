---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const businessName = 'Arizona Toilet Repair Co.';
const phone = '(833) 845-0906';
const address = '9009 N 7th St #201, Phoenix, AZ 85020, USA';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      name: `About ${businessName}`,
      description: 'Learn about Arizona Toilet Repair Co., our 15+ years of dedicated plumbing experience, licensing credentials, and statewide service across Arizona.',
      mainEntity: {
        '@type': 'PlumbingContractor',
        name: businessName,
        telephone: '+1-833-845-0906',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '9009 N 7th St #201',
          addressLocality: 'Phoenix',
          addressRegion: 'AZ',
          postalCode: '85020',
          addressCountry: 'US',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toiletrepairaz.us/' },
        { '@type': 'ListItem', position: 2, name: 'About Us', item: 'https://toiletrepairaz.us/about-us/' },
      ],
    },
  ],
});
---

<BaseLayout
  title={`About Us | 15+ Years Licensed Plumbing in Arizona`}
  description={`Learn about Arizona Toilet Repair Co. With 15+ years of licensed plumbing experience, we provide trusted 24/7 toilet repair across Arizona. Call ${phone}.`}
  canonical="https://toiletrepairaz.us/about-us/"
  schema={schema}
>
  <Header slot="header" businessName={businessName} phone={phone} />

  <div class="breadcrumb-bar" style="background: var(--color-bg-alt); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">About Us</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section (Furnace Repair Pros 2-Column Style) -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-status-pill">
          <span class="pulse-indicator"><span class="pulse-ping"></span><span class="pulse-core"></span></span>
          <span>24/7 Arizona Plumbing Specialists Since 2009</span>
        </div>
        <h1>About Arizona <span class="highlight">Toilet Repair Co.</span><br/>Statewide Master Plumbers</h1>
        <p class="hero-sub">
          With more than 15 years of dedicated master plumbing experience, we specialize exclusively in the diagnosis, restoration, and rebuilding of residential and commercial toilet systems across the Grand Canyon State.
        </p>
        <div class="hero-actions">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="hero-call-btn" id="hero-call-btn">
            <div class="hero-call-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="hero-call-text">
              <span class="hero-call-label">Call 24/7 Service</span>
              <span class="hero-call-number">{phone}</span>
            </div>
          </a>
          <a class="hero-secondary-btn" id="hero-locations-btn" href="/locations/">
            <span>Browse 187 Cities</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
        <div class="hero-bullets">
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>ROC Licensed #329841</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Upfront Flat-Rate</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>24/7 Statewide Dispatch</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-card-frame">
          <img
            src="/images/toilet-repair-tools-service.jpg"
            alt="Experienced licensed plumbing technicians specializing in toilet repair in Arizona"
            title="About Arizona Toilet Repair Co."
            width="900"
            height="650"
            loading="eager"
            fetchpriority="high"
            class="hero-main-img"
          />
          <div class="hero-same-day-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>15+ Years in AZ</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Strip -->
  <section style="background: var(--color-bg); padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); text-align: center;">
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">15+ Years in AZ</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Established local company</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">ROC Licensed & Insured</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Comprehensive state credentialing</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">187 Cities Covered</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Full Arizona footprint</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">24/7 Live Dispatch</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Always open for emergencies</span></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding: var(--space-16) 0;">
    <div class="container" style="max-width: 860px; margin: 0 auto;">
      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Our Story: Built on Honest Work & Specialized Skill</h2>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        Arizona Toilet Repair Co. was founded over 15 years ago with a single mission: to provide straightforward, highly specialized plumbing expertise focused on toilets. Too often, homeowners call large general plumbing corporations and face junior apprentices who suggest complete, unnecessary bathroom overhauls for a simple broken flange or calcified flush valve.
      </p>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        We recognized early on that Arizona's climate and water chemistry require a distinct approach. Dissolved minerals from the Colorado and Salt Rivers attack rubber seals within 24 to 36 months, high municipal water pressure stresses internal fill diaphragms, and expansive desert clay soils shift foundation slabs and snap rigid closet flanges. By specializing in toilet systems, we carry the exact commercial-grade parts and diagnostic tools required to solve the problem properly on the very first visit.
      </p>

      <div style="background: var(--color-bg-alt); padding: var(--space-8); border-radius: var(--radius-lg); margin: var(--space-10) 0;">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.4rem;">The Principles We Operate By:</h3>
        <ul style="line-height: 1.8; color: var(--color-text-secondary); margin-left: var(--space-4);">
          <li><strong>Honest Upfront Flat Pricing:</strong> You are provided with a complete, transparent quote before any repair begins. No surprise hourly charges, no trip fees added after the fact.</li>
          <li><strong>Desert-Grade Components:</strong> We never install cheap generic rubber parts that degrade in Arizona water. We use commercial silicone flappers, brass bolts, and anti-siphon valve assemblies.</li>
          <li><strong>Cleanliness & Respect:</strong> Our technicians wear shoe covers, protect your bathroom flooring, sanitize the fixture, and leave the workspace cleaner than we found it.</li>
          <li><strong>Statewide Availability:</strong> Every resident across our 187 served cities receives the same prompt, professional standard of care whether located in central Phoenix or rural Arizona.</li>
        </ul>
      </div>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Licensing, Credentials & Accountability</h2>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        Plumbing repairs involve pressurized potable water lines and sanitary drain waste systems. Unlicensed handymen frequently cause catastrophic sewage leaks or compromise drinking water safety. Arizona Toilet Repair Co. holds active, verified contracting licenses under the <a href="https://roc.az.gov/" target="_blank" rel="noopener nofollow" style="color: var(--color-primary); text-decoration: underline;">Arizona Registrar of Contractors (ROC)</a>, backed by comprehensive commercial general liability insurance and bonded protection for your peace of mind.
      </p>

      <!-- Head Office Block -->
      <div style="border: 2px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-6); background: white; margin-top: var(--space-8);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-2);">Main Headquarters & Dispatch Facility</h3>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-2);"><strong>Headquarters:</strong> {address}</p>
        <p style="color: var(--color-text-secondary); margin-bottom: var(--space-2);"><strong>Phone:</strong> {phone}</p>
        <p style="color: var(--color-text-secondary); margin-bottom: 0;"><strong>Operating Hours:</strong> 24 Hours a Day, 7 Days a Week, 365 Days a Year</p>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band" style="background: var(--color-primary); color: white; padding: var(--space-12) 0;">
    <div class="container text-center">
      <h2 style="color: white; font-size: 2rem; margin-bottom: var(--space-3);">Work With Arizona's Dedicated Toilet Specialists</h2>
      <p style="font-size: 1.1rem; color: rgba(255,255,255,0.9); max-width: 600px; margin: 0 auto var(--space-6);">
        Experience the difference 15+ years of specialized craftsmanship makes. Call us 24/7 for immediate dispatch anywhere in Arizona.
      </p>
      <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg btn--phone">
        Call 24/7 Dispatch: {phone}
      </a>
    </div>
  </section>

  <Footer slot="footer" businessName={businessName} phone={phone} />
</BaseLayout>
