---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const businessName = 'Arizona Toilet Repair Co.';
const phone = '(833) 845-0906';
const serviceTitle = 'Running Toilet Repair';
const serviceSlug = 'running-toilet-repair';

const faqs = [
  {
    q: 'How much water does a constantly running toilet waste in Arizona?',
    a: 'A running toilet can waste between 30 and 200 gallons of water per day, and up to 6,000 gallons per month. In Arizona, where tiered municipal water rates are strictly enforced, this can add $70 to $200+ to your monthly utility bill without warning.',
  },
  {
    q: 'What is phantom flushing and why does my toilet refill on its own?',
    a: 'Phantom flushing occurs when water slowly seeps from the tank into the bowl due to a warped flapper or cracked flush valve seat. As the tank water level drops below the fill valve trigger point, the valve suddenly turns on for several seconds to refill the tank, repeating continuously 24/7.',
  },
  {
    q: 'Can jiggling the toilet handle fix a running toilet permanently?',
    a: 'Jiggling the handle only temporarily repositions a stiff flapper or untangles a kinked lift chain. It does not fix the root issue: mineral corrosion, calcification, or rubber breakdown. The toilet will inevitably start running again when no one is around to jiggle the handle.',
  },
  {
    q: 'Why does my toilet make a high-pitched hissing or whistling sound?',
    a: 'Hissing sounds indicate that high-pressure municipal water is forcing its way through a calcified or failing diaphragm inside your fill valve assembly. In Arizona, high water pressure (often 80+ PSI) combined with mineral grit wears down internal valve seals quickly.',
  },
  {
    q: 'Do you replace all internal tank components or just the flapper?',
    a: 'We evaluate the entire internal tank assembly. Often, replacing only the flapper leaves a degraded fill valve or cracked overflow tube intact, leading to another service call weeks later. We provide complete tank rebuild packages using commercial-grade parts with written warranties.',
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${serviceTitle} in Arizona`,
      provider: {
        '@type': 'PlumbingContractor',
        name: businessName,
        telephone: '+1-833-845-0906',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '9009 N 7th St #201',
          addressLocality: 'Phoenix',
          addressRegion: 'AZ',
          postalCode: '85020',
          addressCountry: 'US',
        },
      },
      areaServed: { '@type': 'State', name: 'Arizona' },
      description: 'Expert running toilet repair and phantom flush elimination across Arizona. Stop water waste, lower high bills, and replace worn internal valves.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toiletrepairaz.us/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://toiletrepairaz.us/services/' },
        { '@type': 'ListItem', position: 3, name: serviceTitle, item: `https://toiletrepairaz.us/services/${serviceSlug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title={`Same Day Running Toilet Repair in Arizona | 24/7 Flapper & Valve Service`}
  description={`Stop wasting hundreds of gallons. Arizona Toilet Repair Co. repairs running toilets, phantom flushes, and leaking fill valves across Arizona. Call ${phone}.`}
  canonical={`https://toiletrepairaz.us/services/${serviceSlug}/`}
  schema={schema}
>
  <Header slot="header" businessName={businessName} phone={phone} />

  <div class="breadcrumb-bar" style="background: var(--color-bg-alt); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/services/">Services</a>
        <span class="separator">/</span>
        <span class="current">{serviceTitle}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section (Furnace Repair Pros 2-Column Style) -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-status-pill">
          <span class="pulse-indicator"><span class="pulse-ping"></span><span class="pulse-core"></span></span>
          <span>24/7 Priority Tank Repair Active</span>
        </div>
        <h1>Running Toilet Repair &amp; <span class="highlight">Tank Overhaul</span><br/>Stop Water Waste Fast</h1>
        <p class="hero-sub">
          A running toilet wastes up to 200 gallons of treated municipal water daily. Our certified plumbers diagnose phantom flushing, faulty flapper seals, and misadjusted fill floats to restore quiet, efficient operation immediately.
        </p>
        <div class="hero-actions">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="hero-call-btn" id="hero-call-btn">
            <div class="hero-call-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="hero-call-text">
              <span class="hero-call-label">Call 24/7 Service</span>
              <span class="hero-call-number">{phone}</span>
            </div>
          </a>
          <a class="hero-secondary-btn" id="hero-services-btn" href="/services/">
            <span>All Toilet Services</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
        <div class="hero-bullets">
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>ROC Licensed #329841</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Cut Water Bills</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Upfront Flat-Rate</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-card-frame">
          <img
            src="/images/toilet-flapper-fill-valve-repair.jpg"
            alt="Replacing running toilet flapper and anti-siphon fill valve mechanism inside toilet tank"
            title="Running Toilet Tank Mechanism Repair in Arizona"
            width="900"
            height="650"
            loading="eager"
            fetchpriority="high"
            class="hero-main-img"
          />
          <div class="hero-same-day-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>Same Day Service</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="background: var(--color-bg); padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); text-align: center;">
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">15+ Years Experience</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Licensed ROC & insured</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Water Bill Reduction</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Stop 6,000+ gal/mo waste</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Heavy-Duty Parts</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Engineered for hard water</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Same-Day Dispatch</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Serving all 187 AZ cities</span></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding: var(--space-16) 0;">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">The Root Causes of a Constantly Running Toilet</h2>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        Inside every gravity-fed toilet tank, a delicate balance exists between incoming supply pressure and internal seals. When components fail, water continuously escapes through the overflow tube or down into the bowl. In Arizona, this is rarely just bad luck — it is driven by local environmental factors.
      </p>

      <div style="margin: var(--space-8) 0; text-align: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12); border: 1px solid var(--color-border-light); max-width: 720px; margin: 0 auto;">
          <img
            src="/images/toilet-angle-shutoff-valve.jpg"
            alt="Water supply angle stop and flexible connector inspection to prevent phantom cycling and running toilets"
            title="Toilet Supply Line and Valve Calibration - Arizona"
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: auto; display: block; object-fit: cover;"
          />
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-light); margin-top: var(--space-2); font-style: italic;">
          Calibrating incoming water pressure and installing heavy-duty silicone flappers completely stops wasteful running toilets.
        </p>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-lg); margin-bottom: var(--space-10);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.3rem;">Primary Triggers of Running Toilets in Arizona:</h3>
        <ul style="line-height: 1.8; color: var(--color-text-secondary); margin-left: var(--space-4);">
          <li><strong>Hard Water Scale on Valve Seats:</strong> Heavy calcium deposits crystallize on the flush valve seat, preventing the rubber flapper from creating an airtight watertight seal.</li>
          <li><strong>Chloramine Deterioration:</strong> Water treatment facilities across Arizona use chloramines, which cause standard rubber flappers to blister, melt, and curl at the edges within 24 to 36 months.</li>
          <li><strong>Misaligned or Saturated Floats:</strong> If the float drops too low or rises too high, water continuously trickles down the center overflow tube.</li>
          <li><strong>Defective Fill Valve Shutoff:</strong> Mineral grit wedges into the internal diaphragm, preventing the valve from fully stopping incoming municipal water pressure.</li>
        </ul>
      </div>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Our 4-Step Running Toilet Repair Process</h2>
      <div style="display: grid; gap: var(--space-4); margin-bottom: var(--space-10);">
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">1. Dye Testing & Leak Quantification</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We insert concentrated plumbing dye into the tank without flushing. If color seeps into the bowl within minutes, we pinpoint the exact flapper or flush valve failure.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">2. Water Pressure Verification</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We check incoming water pressure at the angle stop. Excessive street pressure (above 80 PSI) destroys fill valves; we ensure your fixture is operating within safe mechanical thresholds.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">3. Complete Tank Rebuild & Valve Replacement</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We install commercial-grade anti-siphon fill valves and red chemical-resistant silicone flappers designed specifically to repel Arizona calcium scaling.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">4. Water Line Calibration & Acoustic Check</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We calibrate the tank water level exactly 1/2 inch below the top of the overflow pipe, test multiple rapid flushes, and ensure dead-silent shutoff when the tank fills.</p>
        </div>
      </div>

      <p style="font-size: 0.95rem; color: var(--color-text-light); margin-bottom: var(--space-10);">
        Learn more about residential water conservation guidelines through the <a href="https://new.azwater.gov/conservation" target="_blank" rel="noopener nofollow" style="color: var(--color-primary); text-decoration: underline;">Arizona Department of Water Resources Conservation Program</a>.
      </p>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-6);">Frequently Asked Questions</h2>
      <div class="faq-list" style="margin-bottom: var(--space-10);">
        {faqs.map((faq, i) => (
          <details class="faq-item" id={`faq-${i}`} style="margin-bottom: var(--space-4); border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: var(--space-4); background: white;">
            <summary class="faq-question" style="font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: var(--color-primary);">
              <span>{faq.q}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer" style="margin-top: var(--space-3); color: var(--color-text-secondary); line-height: 1.6;">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div style="border-top: 1px solid var(--color-border-light); padding-top: var(--space-8); margin-bottom: var(--space-8);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-4);">Explore Related Toilet Services:</h3>
        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
          <a href="/services/flapper-fill-valve-replacement/" class="btn btn--outline btn--sm">Flapper & Valve Replacement</a>
          <a href="/services/toilet-leak-repair/" class="btn btn--outline btn--sm">Toilet Leak Repair</a>
          <a href="/services/clogged-toilet-unclogging/" class="btn btn--outline btn--sm">Clogged Toilet Unclogging</a>
          <a href="/services/flange-repair/" class="btn btn--outline btn--sm">Flange Repair</a>
          <a href="/services/emergency-toilet-repair/" class="btn btn--outline btn--sm">Emergency Toilet Repair</a>
          <a href="/services/commercial-toilet-repair/" class="btn btn--outline btn--sm">Commercial Restroom Repair</a>
        </div>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-md);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.15rem;">Same Day Running Toilet Repair Across Arizona Communities:</h3>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          Stop phantom flushes and soaring utility bills with rapid same-day valve rebuilds in:
        </p>
        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
          <a href="/locations/phoenix/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Phoenix Running Toilet Fix</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/tucson/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Tucson Water Bill Diagnostic</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/mesa/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Mesa Fill Valve Service</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/scottsdale/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Scottsdale Silent Leak Fix</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/chandler/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Chandler Phantom Flush Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/gilbert/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Gilbert Running Toilet Service</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/surprise/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Surprise Valve Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/" style="color: var(--color-accent); font-weight: 700; text-decoration: underline; font-size: 0.9rem;">View All 187 Cities &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band" style="background: var(--color-primary); color: white; padding: var(--space-12) 0;">
    <div class="container text-center">
      <h2 style="color: white; font-size: 2rem; margin-bottom: var(--space-3);">Tired of That Toilet Running Non-Stop?</h2>
      <p style="font-size: 1.1rem; color: rgba(255,255,255,0.9); max-width: 600px; margin: 0 auto var(--space-6);">
        Stop throwing hundreds of gallons and dollars away each month. Call our licensed Arizona plumbing specialists for immediate same-day service.
      </p>
      <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg btn--phone">
        Call 24/7 Dispatch: {phone}
      </a>
    </div>
  </section>

  <Footer slot="footer" businessName={businessName} phone={phone} />
</BaseLayout>
