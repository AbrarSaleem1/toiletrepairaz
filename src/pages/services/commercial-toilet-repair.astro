---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const businessName = 'Arizona Toilet Repair Co.';
const phone = '(833) 845-0906';
const serviceTitle = 'Commercial Toilet Repair';
const serviceSlug = 'commercial-toilet-repair';

const faqs = [
  {
    q: 'Do your plumbers service commercial flushometer valves like Sloan and Zurn?',
    a: 'Yes. We are factory-trained on manual and sensor-activated diaphragm and piston Flushometers, including Sloan Royal, Regal, Optima, and Zurn AquaVantage systems. We carry repair diaphragms, vacuum breakers, and control stops on all service trucks.',
  },
  {
    q: 'Can you service commercial restrooms after normal business hours to prevent customer disruption?',
    a: 'Yes. We provide 24/7 commercial dispatch across Arizona. We can schedule repairs during evening, night, or weekend hours so your business, restaurant, clinic, or office operations continue without restroom closures during business hours.',
  },
  {
    q: 'What causes commercial toilets to continuously run or cycle without stopping?',
    a: 'Flushometers rely on a delicate pressure differential across an internal rubber diaphragm with an ultra-fine bypass orifice. In Arizona, hard water calcium flakes clog this microscopic orifice, preventing the valve chamber from repressurizing, which causes the flushometer to run indefinitely at high volume.',
  },
  {
    q: 'Do you ensure commercial toilet repairs meet ADA compliance guidelines?',
    a: 'Yes. We verify ADA height standards (17 to 19 inches from floor to top of seat), proper flush lever placement on the open side of the stall, wall clearance requirements, and grab bar compliance for commercial facilities throughout Arizona.',
  },
  {
    q: 'Do you offer commercial service accounts or direct corporate invoicing?',
    a: 'Yes. We work directly with property managers, restaurant owners, facility supervisors, and commercial real estate operators across Arizona with itemized invoicing, detailed work logs, and priority dispatch agreements.',
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${serviceTitle} in Arizona`,
      provider: {
        '@type': 'PlumbingContractor',
        name: businessName,
        telephone: '+1-833-845-0906',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '9009 N 7th St #201',
          addressLocality: 'Phoenix',
          addressRegion: 'AZ',
          postalCode: '85020',
          addressCountry: 'US',
        },
      },
      areaServed: { '@type': 'State', name: 'Arizona' },
      description: 'Professional commercial toilet repair and Sloan Flushometer service across Arizona. Rapid 24/7 dispatch for restaurants, offices, retail, and commercial facilities.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toiletrepairaz.us/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://toiletrepairaz.us/services/' },
        { '@type': 'ListItem', position: 3, name: serviceTitle, item: `https://toiletrepairaz.us/services/${serviceSlug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title={`Same Day Commercial Toilet Repair in Arizona | Sloan Flushometer Service`}
  description={`Commercial restroom toilet repair across Arizona. Arizona Toilet Repair Co. repairs Sloan flushometers, ADA fixtures, and high-traffic toilets. 24/7 dispatch: ${phone}.`}
  canonical={`https://toiletrepairaz.us/services/${serviceSlug}/`}
  schema={schema}
>
  <Header slot="header" businessName={businessName} phone={phone} />

  <div class="breadcrumb-bar" style="background: var(--color-bg-alt); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/services/">Services</a>
        <span class="separator">/</span>
        <span class="current">{serviceTitle}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section (Furnace Repair Pros 2-Column Style) -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-status-pill">
          <span class="pulse-indicator"><span class="pulse-ping"></span><span class="pulse-core"></span></span>
          <span>24/7 Commercial Priority Dispatch Active</span>
        </div>
        <h1>Commercial Toilet &amp; <span class="highlight">Flushometer Repair</span><br/>Sloan &amp; Zurn Specialists</h1>
        <p class="hero-sub">
          Out-of-order restrooms create negative customer impressions and regulatory concerns. We service Sloan flushometers, Zurn diaphragms, wall-hung fixtures, and commercial carrier systems across Arizona retail, corporate, and medical properties.
        </p>
        <div class="hero-actions">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="hero-call-btn" id="hero-call-btn">
            <div class="hero-call-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="hero-call-text">
              <span class="hero-call-label">Commercial Dispatch</span>
              <span class="hero-call-number">{phone}</span>
            </div>
          </a>
          <a class="hero-secondary-btn" id="hero-services-btn" href="/services/">
            <span>All Toilet Services</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
        <div class="hero-bullets">
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>ROC Licensed #329841</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>After-Hours Available</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Upfront Flat-Rate</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-card-frame">
          <img
            src="/images/toilet-repair-tools-service.jpg"
            alt="Commercial restroom toilet repair and heavy-duty flush valve servicing across Arizona"
            title="Commercial Toilet Repair Service in Arizona"
            width="900"
            height="650"
            loading="eager"
            fetchpriority="high"
            class="hero-main-img"
          />
          <div class="hero-same-day-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>Same Day Service</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="background: var(--color-bg); padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); text-align: center;">
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">15+ Years Commercial</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Licensed ROC & insured</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Flushometer Pros</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Sloan, Zurn & Kohler parts</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">After-Hours Service</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Zero operational downtime</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Statewide Coverage</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Serving all 187 AZ cities</span></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding: var(--space-16) 0;">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Commercial Restroom Solutions We Provide</h2>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        Commercial restrooms endure extreme usage volumes compared to residential fixtures. From shopping centers and restaurant chains to medical offices and school districts, we service heavy-duty direct water supply systems that require specialized tools and commercial credentials.
      </p>

      <div style="margin: var(--space-8) 0; text-align: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12); border: 1px solid var(--color-border-light); max-width: 720px; margin: 0 auto;">
          <img
            src="/images/toilet-flapper-fill-valve-repair.jpg"
            alt="Servicing commercial toilet diaphragm and high-pressure flush valve mechanism in Arizona business facility"
            title="Commercial Flush Valve Service - Arizona Toilet Repair Co."
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: auto; display: block; object-fit: cover;"
          />
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-light); margin-top: var(--space-2); font-style: italic;">
          Heavy-duty commercial flushometer repairs and rebuilds designed to keep high-traffic business restrooms fully operational.
        </p>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-lg); margin-bottom: var(--space-10);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.3rem;">Key Commercial Toilet Capabilities:</h3>
        <ul style="line-height: 1.8; color: var(--color-text-secondary); margin-left: var(--space-4);">
          <li><strong>Flushometer Valve Rebuilds:</strong> Replacement of calcified diaphragms, vacuum breaker assemblies, control stop seals, and handle gaskets on Sloan and Zurn units.</li>
          <li><strong>Hands-Free Sensor Calibration:</strong> Diagnostic repair and solenoid replacement for infrared sensor flush systems.</li>
          <li><strong>Wall-Hung Carrier Re-anchoring:</strong> Structural repair of commercial in-wall carrier brackets and neoprene seal gaskets preventing wall seepage.</li>
          <li><strong>High-Frequency Main Stoppage Clearing:</strong> Mechanical snake clearing for multi-fixture waste stacks and grease/paper obstructions.</li>
          <li><strong>ADA Accessibility Compliance:</strong> Fixture height verification and compliant handle retrofits.</li>
        </ul>
      </div>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Our 4-Step Commercial Repair Execution</h2>
      <div style="display: grid; gap: var(--space-4); margin-bottom: var(--space-10);">
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">1. Facility Arrival & Restroom Isolation</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We coordinate with building management, place professional signage, and isolate the specific stall to avoid shutting down the entire commercial restroom.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">2. Valve Chamber & Supply Stop Service</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We inspect incoming line pressure (minimum 25–35 PSI required for commercial bowls), disassemble the valve body, and clear calcium build-up from bypass passages.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">3. Heavy-Duty Component Rebuilding</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We install genuine factory Sloan or Zurn repair kits, replace worn synthetic rubber diaphragms, and seal all internal brass fittings with high-temperature plumbing lubricant.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">4. High-Volume Pressure Testing & Documentation</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We verify gallon-per-flush volume (1.28 or 1.6 GPF calibration), test vacuum breaker siphon prevention, provide sanitized cleanup, and deliver complete work order documentation.</p>
        </div>
      </div>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-6);">Frequently Asked Questions</h2>
      <div class="faq-list" style="margin-bottom: var(--space-10);">
        {faqs.map((faq, i) => (
          <details class="faq-item" id={`faq-${i}`} style="margin-bottom: var(--space-4); border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: var(--space-4); background: white;">
            <summary class="faq-question" style="font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: var(--color-primary);">
              <span>{faq.q}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer" style="margin-top: var(--space-3); color: var(--color-text-secondary); line-height: 1.6;">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div style="border-top: 1px solid var(--color-border-light); padding-top: var(--space-8); margin-bottom: var(--space-8);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-4);">Explore Related Toilet Services:</h3>
        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
          <a href="/services/emergency-toilet-repair/" class="btn btn--outline btn--sm">Emergency Toilet Repair</a>
          <a href="/services/clogged-toilet-unclogging/" class="btn btn--outline btn--sm">Clogged Toilet Unclogging</a>
          <a href="/services/toilet-leak-repair/" class="btn btn--outline btn--sm">Toilet Leak Repair</a>
          <a href="/services/running-toilet-repair/" class="btn btn--outline btn--sm">Running Toilet Repair</a>
          <a href="/services/flange-repair/" class="btn btn--outline btn--sm">Flange Repair</a>
          <a href="/services/flapper-fill-valve-replacement/" class="btn btn--outline btn--sm">Flapper & Valve Replacement</a>
        </div>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-md);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.15rem;">Commercial Restroom & Flushometer Service Across Arizona:</h3>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          Trusted commercial toilet plumbing for retail, office, healthcare, and industrial facilities in:
        </p>
        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
          <a href="/locations/phoenix/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Phoenix Commercial Toilet Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/tucson/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Tucson Commercial Restroom Service</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/mesa/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Mesa Sloan Flushometer Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/scottsdale/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Scottsdale Luxury Restroom Plumber</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/tempe/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Tempe High-Traffic Restrooms</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/chandler/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Chandler Commercial Plumbing</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/glendale/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Glendale Commercial Toilets</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/" style="color: var(--color-accent); font-weight: 700; text-decoration: underline; font-size: 0.9rem;">View All 187 Cities &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band" style="background: var(--color-primary); color: white; padding: var(--space-12) 0;">
    <div class="container text-center">
      <h2 style="color: white; font-size: 2rem; margin-bottom: var(--space-3);">Keep Your Business Restrooms Open & Flawless</h2>
      <p style="font-size: 1.1rem; color: rgba(255,255,255,0.9); max-width: 600px; margin: 0 auto var(--space-6);">
        Call Arizona Toilet Repair Co. 24/7 for prompt commercial plumbing response. We keep your facility compliant and running smoothly.
      </p>
      <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg btn--phone">
        Call 24/7 Commercial Dispatch: {phone}
      </a>
    </div>
  </section>

  <Footer slot="footer" businessName={businessName} phone={phone} />
</BaseLayout>
