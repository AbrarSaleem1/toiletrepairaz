---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const businessName = 'Arizona Toilet Repair Co.';
const phone = '(833) 845-0906';
const serviceTitle = 'Toilet Leak Repair';
const serviceSlug = 'toilet-leak-repair';

const faqs = [
  {
    q: 'How do I know if water pooling around my toilet base is clean water or sewer water?',
    a: 'Any water seeping from beneath the toilet base should be treated as contaminated black water. When the wax seal degrades, wastewater escapes beneath the bowl every time the toilet flushes, seeping into the subfloor and around bathroom tiles.',
  },
  {
    q: 'Can a toilet tank crack be repaired or does the tank need replacement?',
    a: 'Hairline cracks in the porcelain tank or bowl cannot be safely epoxied or patched. Water pressure and temperature fluctuations will cause temporary patches to fail catastrophically, risking severe bathroom flooding. We recommend replacing either the tank assembly or the complete fixture.',
  },
  {
    q: 'What causes tank-to-bowl leaks in Arizona homes?',
    a: 'The large rubber spud washer between the tank and bowl, along with the rubber washers on the tank bolts, deteriorate rapidly in Arizona due to high chloramine levels in municipal water combined with intense summer bathroom temperatures.',
  },
  {
    q: 'Will homeowners insurance cover water damage caused by a leaking toilet?',
    a: 'Most policies cover sudden and accidental water damage (such as a burst supply line). However, gradual damage from a long-term neglected base leak is often excluded. Prompt professional repair protects your property and documentation.',
  },
  {
    q: 'Do you use traditional wax rings or modern wax-free seals for base repairs?',
    a: 'We evaluate your specific bathroom foundation. In Arizona, where concrete slab settling and high radiant floor temperatures can soften or displace traditional wax, we frequently install heavy-duty reinforced urethane or rubberized wax-free gasket systems with brass closet bolts.',
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${serviceTitle} in Arizona`,
      provider: {
        '@type': 'PlumbingContractor',
        name: businessName,
        telephone: '+1-833-845-0906',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '9009 N 7th St #201',
          addressLocality: 'Phoenix',
          addressRegion: 'AZ',
          postalCode: '85020',
          addressCountry: 'US',
        },
      },
      areaServed: { '@type': 'State', name: 'Arizona' },
      description: 'Professional toilet leak detection, base wax seal replacement, tank-to-bowl gasket rebuilding, and supply line repairs across Arizona.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toiletrepairaz.us/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://toiletrepairaz.us/services/' },
        { '@type': 'ListItem', position: 3, name: serviceTitle, item: `https://toiletrepairaz.us/services/${serviceSlug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title={`Same Day Toilet Leak Repair in Arizona | 24/7 Water Damage Prevention`}
  description={`Stop damaging toilet leaks immediately. Arizona Toilet Repair Co. fixes base leaks, wax ring failures, tank gaskets, and supply stops across Arizona. Call ${phone}.`}
  canonical={`https://toiletrepairaz.us/services/${serviceSlug}/`}
  schema={schema}
>
  <Header slot="header" businessName={businessName} phone={phone} />

  <div class="breadcrumb-bar" style="background: var(--color-bg-alt); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/services/">Services</a>
        <span class="separator">/</span>
        <span class="current">{serviceTitle}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section (Furnace Repair Pros 2-Column Style) -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-status-pill">
          <span class="pulse-indicator"><span class="pulse-ping"></span><span class="pulse-core"></span></span>
          <span>24/7 Priority Leak Repair Active</span>
        </div>
        <h1>Toilet Leak Repair &amp; <span class="highlight">Seal Restoration</span><br/>Stop Water Damage Fast</h1>
        <p class="hero-sub">
          Water pooling around your toilet base or dripping behind the tank can rapidly destroy bathroom subflooring. Arizona Toilet Repair Co. eliminates toilet leaks with heavy-duty wax seals, brass bolts, and pressure-tested lines.
        </p>
        <div class="hero-actions">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="hero-call-btn" id="hero-call-btn">
            <div class="hero-call-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="hero-call-text">
              <span class="hero-call-label">Call 24/7 Service</span>
              <span class="hero-call-number">{phone}</span>
            </div>
          </a>
          <a class="hero-secondary-btn" id="hero-services-btn" href="/services/">
            <span>All Toilet Services</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
        <div class="hero-bullets">
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>ROC Licensed #329841</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Zero Subfloor Rot</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Upfront Flat-Rate</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-card-frame">
          <img
            src="/images/toilet-wax-ring-leak-repair.jpg"
            alt="Technician replacing degraded wax ring seal to fix toilet base leaks in Arizona"
            title="Toilet Base Wax Ring Leak Repair in Arizona"
            width="900"
            height="650"
            loading="eager"
            fetchpriority="high"
            class="hero-main-img"
          />
          <div class="hero-same-day-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>Same Day Service</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="background: var(--color-bg); padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); text-align: center;">
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">15+ Years Experience</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Licensed ROC & insured</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Zero Hidden Fees</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Upfront transparent pricing</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Durable Seal Upgrades</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Heat & chloramine resistant</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">24/7 Availability</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Emergency plumbers on call</span></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding: var(--space-16) 0;">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Where Toilet Leaks Occur & How We Fix Them</h2>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        Toilets possess several potential failure points where pressurized water or wastewater can breach seals. In Arizona, high municipal water pressure (frequently exceeding 80 PSI in parts of the Phoenix East and West Valleys) and mineral crystallization accelerate gasket breakdown.
      </p>

      <div style="margin: var(--space-8) 0; text-align: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12); border: 1px solid var(--color-border-light); max-width: 720px; margin: 0 auto;">
          <img
            src="/images/toilet-angle-shutoff-valve.jpg"
            alt="Replacing leaking toilet shutoff angle stop valve and braided supply line in Arizona"
            title="Toilet Water Shutoff Valve Replacement - Arizona"
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: auto; display: block; object-fit: cover;"
          />
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-light); margin-top: var(--space-2); font-style: italic;">
          High-pressure brass quarter-turn valves and stainless steel braided supply lines prevent catastrophic bathroom flooding.
        </p>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-lg); margin-bottom: var(--space-10);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.3rem;">Common Toilet Leak Sources We Repair:</h3>
        <ul style="line-height: 1.8; color: var(--color-text-secondary); margin-left: var(--space-4);">
          <li><strong>Base Leaks (Failed Wax Ring):</strong> Sewage water pooling around the base of the toilet every time it is flushed. We pull the toilet, inspect the closet flange, and install high-grade reinforced seals.</li>
          <li><strong>Tank-to-Bowl Gasket Leaks:</strong> Deteriorated sponge rubber washers or corroded tank bolts dripping clean water continuously onto the back of the bowl.</li>
          <li><strong>Water Supply Line & Shutoff Valve:</strong> Cracking flexible supply lines or calcified angle stop valves dripping under pressure behind the toilet.</li>
          <li><strong>Hairline Porcelain Cracks:</strong> Micro-fissures in the bowl or tank caused by over-tightening bolts or foundation settling.</li>
        </ul>
      </div>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">The Danger of Ignoring a Toilet Leak in Arizona</h2>
      <p style="line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        Many homes in Arizona are constructed on concrete post-tension slabs, while others feature framed subfloors over crawlspaces or second stories. When a toilet base leaks on a slab, water migrates underneath tile underlayment, loosening tiles, degrading adhesive, and causing black mold growth. On a wood subfloor or upstairs bathroom, an unresolved toilet leak will rot the plywood subfloor, compromise joists, and eventually collapse through the downstairs ceiling.
      </p>

      <!-- Step-by-Step -->
      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Our Professional Leak Repair Execution</h2>
      <div style="display: grid; gap: var(--space-4); margin-bottom: var(--space-10);">
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">1. Isolation & Pressure Diagnosis</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We isolate the water supply, inspect the angle stop valve, and run pressure checks to identify whether the leak is dynamic (during flush) or static (constant pressure).</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">2. Disassembly & Component Inspection</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">For base leaks, we safely remove the toilet, scrape away degraded wax, inspect the subfloor for moisture saturation, and verify the integrity of the closet flange.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">3. Heavy-Duty Seal Installation</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We install commercial-grade solid brass tank bolts, heavy rubberized spud washers, and durable high-temperature wax or rubber seals engineered for desert conditions.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">4. Re-anchoring, Leveling & Verification</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">The fixture is reset, leveled with solid shims if the floor is uneven, bolted securely without stress-cracking porcelain, and tested under repeated full-tank flushes.</p>
        </div>
      </div>

      <p style="font-size: 0.95rem; color: var(--color-text-light); margin-bottom: var(--space-10);">
        All repairs comply with the Uniform Plumbing Code as enforced across Arizona municipalities and guidelines overseen by the <a href="https://roc.az.gov/" target="_blank" rel="noopener nofollow" style="color: var(--color-primary); text-decoration: underline;">Arizona Registrar of Contractors</a>.
      </p>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-6);">Frequently Asked Questions</h2>
      <div class="faq-list" style="margin-bottom: var(--space-10);">
        {faqs.map((faq, i) => (
          <details class="faq-item" id={`faq-${i}`} style="margin-bottom: var(--space-4); border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: var(--space-4); background: white;">
            <summary class="faq-question" style="font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: var(--color-primary);">
              <span>{faq.q}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer" style="margin-top: var(--space-3); color: var(--color-text-secondary); line-height: 1.6;">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div style="border-top: 1px solid var(--color-border-light); padding-top: var(--space-8); margin-bottom: var(--space-8);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-4);">Explore Related Toilet Services:</h3>
        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
          <a href="/services/flange-repair/" class="btn btn--outline btn--sm">Flange Repair</a>
          <a href="/services/running-toilet-repair/" class="btn btn--outline btn--sm">Running Toilet Repair</a>
          <a href="/services/flapper-fill-valve-replacement/" class="btn btn--outline btn--sm">Flapper & Valve Replacement</a>
          <a href="/services/clogged-toilet-unclogging/" class="btn btn--outline btn--sm">Clogged Toilet Unclogging</a>
          <a href="/services/emergency-toilet-repair/" class="btn btn--outline btn--sm">Emergency Toilet Repair</a>
          <a href="/services/commercial-toilet-repair/" class="btn btn--outline btn--sm">Commercial Restroom Repair</a>
        </div>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-md);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.15rem;">Same Day Toilet Leak Repair Across Key Arizona Cities:</h3>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          Our licensed mobile technicians repair toilet base leaks, wax ring failures, and supply lines daily in:
        </p>
        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
          <a href="/locations/phoenix/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Phoenix Toilet Leak Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/tucson/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Tucson Leak Diagnostics</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/mesa/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Mesa Wax Ring Replacement</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/scottsdale/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Scottsdale Toilet Leak Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/chandler/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Chandler Base Leak Fix</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/gilbert/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Gilbert Toilet Seal Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/peoria/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Peoria Tank Leak Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/" style="color: var(--color-accent); font-weight: 700; text-decoration: underline; font-size: 0.9rem;">View All 187 Cities &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band" style="background: var(--color-primary); color: white; padding: var(--space-12) 0;">
    <div class="container text-center">
      <h2 style="color: white; font-size: 2rem; margin-bottom: var(--space-3);">Water Leaking From Your Toilet Tank or Base?</h2>
      <p style="font-size: 1.1rem; color: rgba(255,255,255,0.9); max-width: 600px; margin: 0 auto var(--space-6);">
        Stop the leak before expensive floor rot occurs. Call our licensed Arizona plumbers 24/7 for prompt, upfront flat-rate repair.
      </p>
      <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg btn--phone">
        Call 24/7 Dispatch: {phone}
      </a>
    </div>
  </section>

  <Footer slot="footer" businessName={businessName} phone={phone} />
</BaseLayout>
