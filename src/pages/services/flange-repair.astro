---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const businessName = 'Arizona Toilet Repair Co.';
const phone = '(833) 845-0906';
const serviceTitle = 'Toilet Flange Repair';
const serviceSlug = 'flange-repair';

const faqs = [
  {
    q: 'What causes a toilet to wobble or rock side to side on the floor?',
    a: 'A rocking toilet almost always signals a broken or cracked closet flange ring, loose floor anchoring screws, or a flange installed too high above finished tile. When the bowl rocks, the wax seal underneath breaks immediately, allowing sewer gas and water to leak out with every flush.',
  },
  {
    q: 'Can a broken cast-iron closet flange be repaired without tearing up the concrete slab?',
    a: 'Yes. In older Arizona homes built on concrete slabs, cast-iron collars often rust out. We install engineered split stainless steel repair rings or internal compression mechanical flanges that anchor securely into the existing cast-iron pipe without requiring concrete jackhammering.',
  },
  {
    q: 'What height should a toilet flange be installed relative to finished tile?',
    a: 'According to plumbing codes enforced across Arizona, the bottom of the flange ring should sit flush on top of the finished flooring, with the flange collar resting approximately 1/4 inch above the finished floor level. When remodelers tile around an existing flange without raising it, the flange sits too low, causing premature wax ring failure.',
  },
  {
    q: 'What happens if a damaged toilet flange is left unaddressed?',
    a: 'Left unrepaired, leaking wastewater rots wood subflooring in framed homes or causes concrete degradation and rebar corrosion in post-tension slabs. The continuous movement will eventually crack the porcelain base of the toilet.',
  },
  {
    q: 'How long does a professional closet flange repair or replacement take?',
    a: 'Most flange repairs take between 1.5 and 2.5 hours, including toilet removal, old wax removal, flange reconstruction, subfloor stabilization, new wax-free gasket installation, toilet resetting, and flush testing.',
  },
];

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: `${serviceTitle} in Arizona`,
      provider: {
        '@type': 'PlumbingContractor',
        name: businessName,
        telephone: '+1-833-845-0906',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '9009 N 7th St #201',
          addressLocality: 'Phoenix',
          addressRegion: 'AZ',
          postalCode: '85020',
          addressCountry: 'US',
        },
      },
      areaServed: { '@type': 'State', name: 'Arizona' },
      description: 'Professional toilet flange repair, replacement, and wobble stabilization across Arizona. Cast iron and PVC closet flange reconstruction on concrete slabs and wood subfloors.',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toiletrepairaz.us/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://toiletrepairaz.us/services/' },
        { '@type': 'ListItem', position: 3, name: serviceTitle, item: `https://toiletrepairaz.us/services/${serviceSlug}/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<BaseLayout
  title={`Same Day Toilet Flange Repair in Arizona | 24/7 Service`}
  description={`Stop wobbling toilets and broken flange leaks. Arizona Toilet Repair Co. repairs cast iron and PVC closet flanges across Arizona. Call ${phone}.`}
  canonical={`https://toiletrepairaz.us/services/${serviceSlug}/`}
  schema={schema}
>
  <Header slot="header" businessName={businessName} phone={phone} />

  <div class="breadcrumb-bar" style="background: var(--color-bg-alt); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <a href="/services/">Services</a>
        <span class="separator">/</span>
        <span class="current">{serviceTitle}</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section (Furnace Repair Pros 2-Column Style) -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-status-pill">
          <span class="pulse-indicator"><span class="pulse-ping"></span><span class="pulse-core"></span></span>
          <span>24/7 Priority Flange Service Active</span>
        </div>
        <div class="hero-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          <span>Licensed & Insured Plumbing Pros • ROC #329841</span>
        </div>
        <h1>Toilet Flange Repair &amp; <span class="highlight">Floor Anchoring</span><br/>Zero Rocking Guarantee</h1>
        <p class="hero-sub">
          A rocking toilet or foul sewer odor indicates a cracked, corroded, or improperly set closet flange. We reconstruct concrete slab and wooden subfloor flanges using heavy-gauge stainless steel repair assemblies that lock bowls solid to the floor.
        </p>
        <div class="hero-actions">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="hero-call-btn" id="hero-call-btn">
            <div class="hero-call-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="hero-call-text">
              <span class="hero-call-label">Call 24/7 Service</span>
              <span class="hero-call-number">{phone}</span>
            </div>
          </a>
          <a class="hero-secondary-btn" id="hero-services-btn" href="/services/">
            <span>All Toilet Services</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
        <div class="hero-bullets">
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>ROC Licensed #329841</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Zero Bowl Rocking</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Upfront Flat-Rate</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-card-frame">
          <img
            src="/images/toilet-flange-reinforcement-repair.jpg"
            alt="Reconstructing cracked PVC closet flange with heavy-duty metal repair ring in Arizona bathroom floor"
            title="Closet Flange Repair and Reconstruction in Arizona"
            width="900"
            height="650"
            loading="eager"
            fetchpriority="high"
            class="hero-main-img"
          />
          <div class="hero-same-day-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>Same Day Service</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section style="background: var(--color-bg); padding: var(--space-6) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4); text-align: center;">
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">15+ Years Experience</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Licensed ROC & insured</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Slab & Wood Solutions</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Cast iron, PVC & ABS</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Rock-Solid Mounting</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Wobble elimination</span></div>
        <div><strong style="color: var(--color-primary); font-size: 1.1rem; display: block;">Upfront Pricing</strong><span style="color: var(--color-text-light); font-size: 0.875rem;">Flat rates, no hidden fees</span></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding: var(--space-16) 0;">
    <div class="container" style="max-width: 900px; margin: 0 auto;">
      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Why Toilet Flanges Fail in Arizona Homes</h2>
      <p style="font-size: 1.1rem; line-height: 1.7; color: var(--color-text-secondary); margin-bottom: var(--space-6);">
        The closet flange connects the toilet base to the home's drainage pipe and holds the closet bolts that anchor the fixture securely to the floor. In Arizona, thousands of homes built between 1950 and 1985 utilize cast-iron waste lines encased in concrete slabs. Decades of sulfur sewer gases rot the cast-iron flange ring until the closet bolt snaps clean through. In newer homes with PVC or ABS piping, thermal expansion, over-tightened bolts, or foundation settling crack the plastic collar slots.
      </p>

      <div style="margin: var(--space-8) 0; text-align: center;">
        <div style="border-radius: 12px; overflow: hidden; box-shadow: 0 8px 24px rgba(0,0,0,0.12); border: 1px solid var(--color-border-light); max-width: 720px; margin: 0 auto;">
          <img
            src="/images/toilet-wax-ring-leak-repair.jpg"
            alt="Securing new wax-free gasket and closet flange bolts onto finished bathroom tile floor"
            title="Toilet Flange and Wax Seal Installation - Arizona"
            width="720"
            height="480"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: auto; display: block; object-fit: cover;"
          />
        </div>
        <p style="font-size: 0.875rem; color: var(--color-text-light); margin-top: var(--space-2); font-style: italic;">
          Precision mechanical flange rings eliminate toilet wobble and create an airtight bond that permanently blocks sewer gas leaks.
        </p>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-lg); margin-bottom: var(--space-10);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.3rem;">Signs Your Toilet Flange Needs Repair:</h3>
        <ul style="line-height: 1.8; color: var(--color-text-secondary); margin-left: var(--space-4);">
          <li>The toilet rocks, tilts, or shifts whenever someone sits down.</li>
          <li>Persistent sewer gas odor in the bathroom even when the bowl is clean.</li>
          <li>Closet bolts spin freely in place and cannot be tightened.</li>
          <li>Water weeps out onto the floor tiles hours after a flush.</li>
          <li>Spongy or discolored flooring immediately surrounding the base.</li>
        </ul>
      </div>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-4);">Our 4-Step Flange Repair Execution</h2>
      <div style="display: grid; gap: var(--space-4); margin-bottom: var(--space-10);">
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">1. Fixture Removal & Flange Inspection</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We pull the toilet, scrape away the compressed seal, and thoroughly evaluate the structural condition of the pipe material and surrounding floor anchoring substrate.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">2. Structural Flange Restoration</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">Depending on the material, we install heavy-gauge stainless steel repair rings, twist-set mechanical expansion flanges, or cut out and solvent-weld new PVC collars.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">3. Solid Masonry or Subfloor Anchoring</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We drill pilot holes and drive heavy Tapcon masonry anchors into concrete slabs or stainless structural screws into wooden subfloors for rock-solid stability.</p>
        </div>
        <div style="padding: var(--space-4); border-left: 4px solid var(--color-accent); background: var(--color-bg);">
          <strong style="color: var(--color-primary); font-size: 1.1rem; display: block; margin-bottom: 4px;">4. High-Performance Reset & Shimming</strong>
          <p style="margin: 0; color: var(--color-text-secondary);">We place a reinforced seal, lower the toilet into position, insert hard-plastic leveling shims to eliminate wobble, tighten solid brass bolts, and test thoroughly.</p>
        </div>
      </div>

      <h2 style="color: var(--color-primary); margin-bottom: var(--space-6);">Frequently Asked Questions</h2>
      <div class="faq-list" style="margin-bottom: var(--space-10);">
        {faqs.map((faq, i) => (
          <details class="faq-item" id={`faq-${i}`} style="margin-bottom: var(--space-4); border: 1px solid var(--color-border-light); border-radius: var(--radius-md); padding: var(--space-4); background: white;">
            <summary class="faq-question" style="font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; align-items: center; color: var(--color-primary);">
              <span>{faq.q}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="faq-answer" style="margin-top: var(--space-3); color: var(--color-text-secondary); line-height: 1.6;">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>

      <div style="border-top: 1px solid var(--color-border-light); padding-top: var(--space-8); margin-bottom: var(--space-8);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-4);">Explore Related Toilet Services:</h3>
        <div style="display: flex; gap: var(--space-4); flex-wrap: wrap;">
          <a href="/services/toilet-leak-repair/" class="btn btn--outline btn--sm">Toilet Leak Repair</a>
          <a href="/services/emergency-toilet-repair/" class="btn btn--outline btn--sm">Emergency Toilet Repair</a>
          <a href="/services/running-toilet-repair/" class="btn btn--outline btn--sm">Running Toilet Repair</a>
          <a href="/services/clogged-toilet-unclogging/" class="btn btn--outline btn--sm">Clogged Toilet Unclogging</a>
          <a href="/services/flapper-fill-valve-replacement/" class="btn btn--outline btn--sm">Flapper & Valve Replacement</a>
          <a href="/services/commercial-toilet-repair/" class="btn btn--outline btn--sm">Commercial Restroom Repair</a>
        </div>
      </div>

      <div style="background: var(--color-bg-alt); padding: var(--space-6); border-radius: var(--radius-md);">
        <h3 style="color: var(--color-primary); margin-bottom: var(--space-3); font-size: 1.15rem;">Closet Flange Repair & Slab Stabilization Across Key Arizona Cities:</h3>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin-bottom: var(--space-4);">
          Fix rocking bowls and cracked flange collars with precision masonry anchoring in:
        </p>
        <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
          <a href="/locations/phoenix/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Phoenix Flange Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/tucson/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Tucson Cast Iron Flange Fix</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/mesa/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Mesa Wobbling Toilet Repair</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/scottsdale/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Scottsdale Tile Flange Raising</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/chandler/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Chandler Slab Flange Anchoring</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/gilbert/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Gilbert Rocking Bowl Stabilization</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/goodyear/" style="color: var(--color-primary); font-weight: 600; text-decoration: underline; font-size: 0.9rem;">Goodyear Flange Rebuilding</a>
          <span style="color: var(--color-text-light);">•</span>
          <a href="/locations/" style="color: var(--color-accent); font-weight: 700; text-decoration: underline; font-size: 0.9rem;">View All 187 Cities &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band" style="background: var(--color-primary); color: white; padding: var(--space-12) 0;">
    <div class="container text-center">
      <h2 style="color: white; font-size: 2rem; margin-bottom: var(--space-3);">Does Your Toilet Rock or Leak at the Base?</h2>
      <p style="font-size: 1.1rem; color: rgba(255,255,255,0.9); max-width: 600px; margin: 0 auto var(--space-6);">
        Don't risk cracked porcelain or subfloor rot. Call Arizona Toilet Repair Co. today for professional flange reconstruction across Arizona.
      </p>
      <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg btn--phone">
        Call 24/7 Dispatch: {phone}
      </a>
    </div>
  </section>

  <Footer slot="footer" businessName={businessName} phone={phone} />
</BaseLayout>
