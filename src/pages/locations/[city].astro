          <p style="color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-4);">
            Our mobile service plumbers operate across {cityName} and {countyName} County 24 hours a day, 7 days a week.
          </p>
          <p style="margin-bottom: var(--space-2);"><strong>Statewide Office:</strong> 9009 N 7th St #201, Phoenix, AZ 85020</p>
          <p style="margin-bottom: var(--space-2);"><strong>Telephone:</strong> <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} style="color: var(--color-primary); font-weight: 700;">{phone}</a></p>
          <p style="margin-bottom: var(--space-2);"><strong>Hours:</strong> Open 24/7 / 365 Days</p>
          <p style="margin-bottom: var(--space-4);"><strong>License:</strong> Arizona ROC #329841</p>
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg" style="width: 100%; text-align: center;">
            Call For Immediate Dispatch: {phone}
          </a>
        </div>
        <div class="card" style="padding: var(--space-4); overflow: hidden; background: white; border-radius: var(--radius-md); border: 1px solid var(--color-border-light);">
          <div style="width: 100%; height: 360px; border-radius: var(--radius-md); overflow: hidden;">
            <iframe
              title={`${cityName} Service Area Map`}
              width="100%"
              height="100%"
              style="border:0;"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3325.2938883656345!2d-112.0674087!3d33.5683262!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x872b6dfd54109407%3A0xe7bc38c201e7dc70!2s9009%20N%207th%20St%20%23201%2C%20Phoenix%2C%20AZ%2085020!5e0!3m2!1sen!2sus!4v1700000000000"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" businessName={businessName} phone={phone} />
</BaseLayout>
