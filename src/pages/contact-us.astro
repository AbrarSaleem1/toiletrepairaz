---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const businessName = 'Arizona Toilet Repair Co.';
const phone = '(833) 845-0906';
const address = '9009 N 7th St #201, Phoenix, AZ 85020, USA';
const email = 'dispatch@toiletrepairaz.us';

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      name: `Contact & Dispatch | ${businessName}`,
      description: 'Contact Arizona Toilet Repair Co. for immediate 24/7 toilet repair dispatch across Arizona. Phone dispatch, headquarters address, and service coverage.',
      mainEntity: {
        '@type': 'PlumbingContractor',
        name: businessName,
        telephone: '+1-833-845-0906',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '9009 N 7th St #201',
          addressLocality: 'Phoenix',
          addressRegion: 'AZ',
          postalCode: '85020',
          addressCountry: 'US',
        },
        geo: {
          '@type': 'GeoCoordinates',
          latitude: '33.5683',
          longitude: '-112.0652',
        },
        openingHoursSpecification: {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '00:00',
          closes: '23:59',
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toiletrepairaz.us/' },
        { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://toiletrepairaz.us/contact-us/' },
      ],
    },
  ],
});
---

<BaseLayout
  title={`Contact 24/7 Dispatch | ${businessName}`}
  description={`Need toilet repair in Arizona? Call Arizona Toilet Repair Co. at ${phone} for immediate 24/7 dispatch across 187 cities. Upfront flat pricing & licensed plumbers.`}
  canonical="https://toiletrepairaz.us/contact-us/"
  schema={schema}
>
  <Header slot="header" businessName={businessName} phone={phone} />

  <div class="breadcrumb-bar" style="background: var(--color-bg-alt); padding: var(--space-3) 0; border-bottom: 1px solid var(--color-border-light);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Contact Us</span>
      </nav>
    </div>
  </div>

  <!-- Hero Section (Furnace Repair Pros 2-Column Style) -->
  <section class="hero">
    <div class="hero-bg-grid" aria-hidden="true"></div>
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-status-pill">
          <span class="pulse-indicator"><span class="pulse-ping"></span><span class="pulse-core"></span></span>
          <span>24/7 Live Emergency Operators Standing By</span>
        </div>
        <div class="hero-eyebrow">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          <span>15+ Years Licensed Arizona Plumbing Specialists</span>
        </div>
        <h1>Contact Arizona <span class="highlight">Toilet Repair Co.</span><br/>Fast 24/7 Live Dispatch</h1>
        <p class="hero-sub">
          When a toilet leaks, runs continuously, or backs up, waiting hours for an email reply isn't an option. Our live dispatch line connects you immediately with a licensed technician ready to roll to your location.
        </p>
        <div class="hero-actions">
          <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="hero-call-btn" id="hero-call-btn">
            <div class="hero-call-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="hero-call-text">
              <span class="hero-call-label">Call 24/7 Service</span>
              <span class="hero-call-number">{phone}</span>
            </div>
          </a>
          <a class="hero-secondary-btn" id="hero-services-btn" href="/services/">
            <span>View All Services</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
        <div class="hero-bullets">
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>ROC Licensed #329841</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Upfront Flat-Rate</span>
          </div>
          <div class="hero-bullet">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22C55E" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>24/7 Statewide Dispatch</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-card-frame">
          <img
            src="/images/toilet-repair-tools-service.jpg"
            alt="Contact 24/7 toilet repair dispatch in Arizona - Arizona Toilet Repair Co."
            title="Contact Arizona Toilet Repair Dispatch"
            width="900"
            height="650"
            loading="eager"
            fetchpriority="high"
            class="hero-main-img"
          />
          <div class="hero-same-day-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>24/7 Live Dispatch</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Cards & Map Grid -->
  <section class="section" style="padding: var(--space-16) 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--space-8); align-items: start;">
        
        <!-- Contact Information Block -->
        <div class="card" style="padding: var(--space-8); border-top: 4px solid var(--color-accent);">
          <h2 style="color: var(--color-primary); font-size: 1.6rem; margin-bottom: var(--space-4);">Direct Dispatch Details</h2>
          <p style="color: var(--color-text-secondary); line-height: 1.6; margin-bottom: var(--space-6);">
            Our central headquarters oversees mobile plumbing units deployed across 187 cities in Arizona. For the fastest response, call our 24/7 direct telephone line.
          </p>

          <div style="display: flex; flex-direction: column; gap: var(--space-5);">
            <div style="display: flex; gap: var(--space-4); align-items: flex-start;">
              <div class="icon-circle" style="background: var(--color-accent-50); color: var(--color-accent);">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <strong style="display: block; font-size: 0.9rem; color: var(--color-text-light); text-transform: uppercase;">Direct Phone Hotline</strong>
                <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} style="font-size: 1.3rem; font-weight: 800; color: var(--color-primary); text-decoration: none;">{phone}</a>
                <span style="display: block; font-size: 0.85rem; color: var(--color-success); font-weight: 600;">● 24/7 Live Operator Available</span>
              </div>
            </div>

            <div style="display: flex; gap: var(--space-4); align-items: flex-start;">
              <div class="icon-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <strong style="display: block; font-size: 0.9rem; color: var(--color-text-light); text-transform: uppercase;">Headquarters Address</strong>
                <span style="font-size: 1.05rem; color: var(--color-text); font-weight: 600;">{address}</span>
              </div>
            </div>

            <div style="display: flex; gap: var(--space-4); align-items: flex-start;">
              <div class="icon-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div>
                <strong style="display: block; font-size: 0.9rem; color: var(--color-text-light); text-transform: uppercase;">Business Hours</strong>
                <span style="font-size: 1.05rem; color: var(--color-text); font-weight: 600;">Open 24 Hours / 7 Days a Week</span>
                <span style="display: block; font-size: 0.85rem; color: var(--color-text-light);">Including Weekends & All Holidays</span>
              </div>
            </div>

            <div style="display: flex; gap: var(--space-4); align-items: flex-start;">
              <div class="icon-circle">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <strong style="display: block; font-size: 0.9rem; color: var(--color-text-light); text-transform: uppercase;">Email Dispatch</strong>
                <a href={`mailto:${email}`} style="font-size: 1rem; color: var(--color-primary);">{email}</a>
              </div>
            </div>
          </div>

          <div style="margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border-light);">
            <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg" style="width: 100%; text-align: center;">
              Call Now For Immediate Dispatch
            </a>
          </div>
        </div>

        <!-- Embedded Google Map Block -->
        <div>
          <div class="card" style="padding: var(--space-4); overflow: hidden;">
            <h3 style="color: var(--color-primary); margin: var(--space-2) var(--space-2) var(--space-4); font-size: 1.3rem;">Service Hub Location</h3>
            <div style="width: 100%; height: 420px; border-radius: var(--radius-md); overflow: hidden;">
              <iframe
                title="Arizona Toilet Repair Co. Location"
                width="100%"
                height="100%"
                style="border:0;"
                loading="lazy"
                allowfullscreen
                referrerpolicy="no-referrer-when-downgrade"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3325.2938883656345!2d-112.0674087!3d33.5683262!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x872b6dfd54109407%3A0xe7bc38c201e7dc70!2s9009%20N%207th%20St%20%23201%2C%20Phoenix%2C%20AZ%2085020!5e0!3m2!1sen!2sus!4v1700000000000"
              ></iframe>
            </div>
            <p style="font-size: 0.85rem; color: var(--color-text-light); margin: var(--space-3) var(--space-2) var(--space-1);">
              Centrally based at 9009 N 7th St #201, Phoenix, AZ 85020, coordinating mobile response vehicles statewide across <a href="/locations/" style="color: var(--color-primary); font-weight: 600;">187 Arizona cities</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band" style="background: var(--color-primary); color: white; padding: var(--space-12) 0;">
    <div class="container text-center">
      <h2 style="color: white; font-size: 2rem; margin-bottom: var(--space-3);">Immediate Plumbing Assistance Anywhere in Arizona</h2>
      <p style="font-size: 1.1rem; color: rgba(255,255,255,0.9); max-width: 600px; margin: 0 auto var(--space-6);">
        No waiting, no forms to fill out, and no automated phone trees. Call our live dispatch team now.
      </p>
      <a href={`tel:${phone.replace(/[^+\d]/g, '')}`} class="btn btn--accent btn--lg btn--phone">
        Call 24/7 Dispatch: {phone}
      </a>
    </div>
  </section>

  <Footer slot="footer" businessName={businessName} phone={phone} />
</BaseLayout>
